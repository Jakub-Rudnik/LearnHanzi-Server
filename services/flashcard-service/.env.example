# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=learnhanzi_user
DB_PASSWORD=learnhanzi_password
DB_NAME=learnhanzi_flashcard

# Frontend Configuration
FRONTEND_URL=http://localhost:4173

# JWT Configuration
JWT_SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=learnhanzi-auth-service
JWT_AUDIENCE=learnhanzi-services

# External Services
DICTIONARY_SERVICE_URL=http://dictionary:8002

# Flashcard Service Configuration
# Accuracy threshold (0-1) for marking a hanzi as difficult
# If accuracy < threshold, the hanzi will be marked as difficult
ACCURACY_DIFFICULTY_THRESHOLD=0.6
